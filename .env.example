# =============================================================================
# Habit Tracker — variables de entorno
# Copia este archivo como .env.local y rellena cada valor.
# NUNCA commitees .env.local — ya está en .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — obligatorio desde T-01
# Origen: dashboard.supabase.com → tu proyecto → Settings → API
# -----------------------------------------------------------------------------

# URL pública del proyecto Supabase (comienza con https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon key) — segura para exponer en el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Stripe — obligatorio para la extensión Premium (no bloquea T-01 a T-19)
# Origen: dashboard.stripe.com → Developers → API keys
# Usar claves de TEST (sk_test_… / pk_test_…) en desarrollo
# -----------------------------------------------------------------------------

# Clave publicable de Stripe (se expone al cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Clave secreta de Stripe (SOLO servidor — nunca en NEXT_PUBLIC_)
STRIPE_SECRET_KEY=

# Secreto del webhook de Stripe para verificar eventos entrantes
# Origen: dashboard.stripe.com → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email de recordatorios — configuración en el dashboard de Supabase,
# no como variable de Next.js. Ver SETUP.md § "Email / SMTP".
# Si usas SMTP propio en Supabase Edge Functions, agregar aquí:
# -----------------------------------------------------------------------------

# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
