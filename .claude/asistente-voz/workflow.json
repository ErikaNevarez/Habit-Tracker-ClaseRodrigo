          { "fieldId": "frequency", "fieldValue": "={{ $json.output.frequency || 'daily' }}" },
          { "fieldId": "target_per_week", "fieldValue": "={{ $json.output.target_per_week || ($json.output.frequency === 'weekly' ? 3 : 7) }}" }
        ] }
      }
    },
    {
      "id": "eb09e302-ec5f-4092-9568-0566231e5882",
